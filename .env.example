DATABASE_URL=file:./data/salon-connect.db
JWT_SECRET=change-me
VITE_APP_ID=salon-connect-local
OWNER_OPEN_ID=local:nadine@justbeauty.local
OWNER_NAME=Nadine

# Production requires a unique JWT_SECRET of at least 32 characters.
# Exact browser origins, comma separated. No wildcard.
ALLOWED_ORIGINS=http://localhost:8081
SALON_TIMEZONE=Asia/Beirut
# Configure the same secret for reminder callbacks; never expose it in EXPO_PUBLIC_*.
SCHEDULER_SECRET=
# Demo accounts must only be seeded deliberately in development.
ENABLE_DEMO_SEED=false
# Optional explicit cookie domain for controlled subdomains. Host-only by default.
SESSION_COOKIE_DOMAIN=
